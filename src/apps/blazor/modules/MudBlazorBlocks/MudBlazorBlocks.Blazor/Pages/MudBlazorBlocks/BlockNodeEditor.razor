@* BlockNodeEditor.razor *@
@page "/block-editor"
@using FSH.Starter.Blazor.Modules.MudBlazorBlocks.Blazor.Abstraction.BlockNode
@using FSH.Starter.Blazor.Modules.MudBlazorBlocks.Blazor.Abstraction.BlockNode.Inputs
@using FSH.Starter.Blazor.Modules.MudBlazorBlocks.Blazor.Components.Blocks.EditForm
@using FSH.Starter.Blazor.Modules.MudBlazorBlocks.Blazor.Components.Blocks.Fields

<div class="container my-4">
    <h2>Dynamic Form with State Reset</h2>

    @if (editContext != null)
    {
        <EditForm EditContext="editContext" OnValidSubmit="HandleValidSubmit">
            <BlockNodeValidationManager Node="currentNode" @bind-IsValidating="isValidating" />

            <div class="card mb-4">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Edit Node: @currentNode.Name</h5>
                    @if (editContext.IsModified())
                    {
                        <span class="badge bg-warning text-dark">Unsaved Changes</span>
                    }
                </div>

                <div class="card-body">
                    <ValidationSummary class="alert alert-danger" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Node Name</label>
                        <InputText class="form-control" @bind-Value="currentNode.Name" />
                    </div>

                    <hr />

                    <h6 class="fw-bold mb-3">Dynamic Inputs</h6>
                    <CascadingValue Value="currentNode" Name="CurrentNode">
                        @foreach (var input in currentNode.Inputs)
                        {
                            <DynamicInputField Input="input" InputChanged="OnInputUpdated" />
                        }
                    </CascadingValue>
                </div>

                <div class="card-footer d-flex gap-2">
                    <button type="submit" class="btn btn-success" disabled="@isValidating">
                        Submit
                    </button>

                    <!-- Reset Button -->
                    <button type="button" 
                            class="btn btn-outline-danger" 
                            @onclick="ResetFormAsync" 
                            disabled="@(!editContext.IsModified() || isValidating)">
                        Reset Form
                    </button>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    private BlockNode initialNodeState = new();
    private BlockNode currentNode = new();
    private EditContext? editContext;
    private bool isValidating = false;
    
    protected override void OnInitialized()
    {
        // LoadData();
        LoadJson();
    }

    private void LoadJson()
    {
        var jsonNode = BlockNode.FromJson(JsonPayload);
        // Keep a pristine master copy
        initialNodeState = jsonNode.DeepClone();

        // Bind form to a fresh clone
        ApplyModelAndResetContext(initialNodeState.DeepClone());
    }
    private void LoadData()
    {
        // Sample node configuration
        var sourceNode = new BlockNode
        {
            Id = "node_701",
            Name = "Original Node Name",
            Inputs = new List<BlockNodeInput>
            {
                new() { 
                    Id = "in_1", 
                    Label = "Username", 
                    Type = "text", 
                    Value = "default_user",
                    Validation = new() { IsRequired = true }
                },
                new() { 
                    Id = "in_2", 
                    Label = "Retry Threshold", 
                    Type = "number", 
                    Value = 5 
                }
            }
        };

        // Keep a pristine master copy
        initialNodeState = sourceNode.DeepClone();

        // Bind form to a fresh clone
        ApplyModelAndResetContext(initialNodeState.DeepClone());
    }
    
    private void ResetFormAsync()
    {
        // 1. Restore the model values from the deep clone
        ApplyModelAndResetContext(initialNodeState.DeepClone());
    }
    private void ApplyModelAndResetContext(BlockNode freshNode)
    {
        currentNode = freshNode;

        // 2. Instantiate a brand-new EditContext
        editContext = new EditContext(currentNode);

        // 3. Mark the context as unmodified to reset field classes
        editContext.MarkAsUnmodified();

        // 4. Force UI refresh
        StateHasChanged();
    }
    
    private void HandleValidSubmit()
    {
        Console.WriteLine("Submitted successfully!");

        // Update the baseline snapshot to the current state after a successful save
        initialNodeState = currentNode.DeepClone();
        editContext?.MarkAsUnmodified();
    }

    private void HandleInvalidSubmit()
    {
        Console.WriteLine("Submission blocked due to invalid fields.");
    }

    private void OnInputUpdated(BlockNodeInput input)
    {
        // Re-render components so visibility and validation state update instantly
        StateHasChanged();
    }
    
    private string ExportJson()
    {
        // jsonText = currentNode.ToJson();
        // errorMessage = string.Empty;
        return currentNode.ToJson();
    }
    private void ImportJson()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(JsonPayload)) return;

            var imported = BlockNode.FromJson(JsonPayload);
            if (imported != null)
            {
                currentNode = imported;
                editContext = new EditContext(currentNode);
                // errorMessage = string.Empty;
            }
        }
        catch (Exception ex)
        {
            // errorMessage = $"Invalid JSON payload: {ex.Message}";
        }
        StateHasChanged();
    }

    
