@using FSH.Starter.Blazor.Modules.MudBlazorBlocks.Blazor.Abstraction.BlockNode
@using FSH.Starter.Blazor.Modules.MudBlazorBlocks.Blazor.Abstraction.BlockNode.Inputs
@* BlockNodeWizard.razor *@
@inject IJSRuntime JSRuntime

@if (editContext != null)
{
    <EditForm EditContext="editContext" OnValidSubmit="HandleFinalSubmit">
        <BlockNodeValidationManager Node="Node" />

        <!-- Wizard Step Header / Tabs -->
        <div class="wizard-steps d-flex justify-content-between mb-4 border-bottom pb-3">
            @for (int i = 1; i <= TotalSteps; i++)
            {
                var stepNum = i;
                var isActive = currentStep == stepNum;
                var isCompleted = stepNum < currentStep;

                <button type="button" 
                        class="btn @(isActive ? "btn-primary" : isCompleted ? "btn-outline-success" : "btn-outline-secondary") rounded-circle px-3 py-2 fw-bold"
                        disabled="@(!isCompleted && !isActive)"
                        @onclick="() => GoToStepAsync(stepNum)">
                    @stepNum
                </button>
            }
        </div>

        <div class="mb-3">
            <span class="text-muted small">Step @currentStep of @TotalSteps</span>
            <h4 class="fw-bold">@GetStepTitle(currentStep)</h4>
        </div>

        <!-- Global Validation Summary for active step errors -->
        <GlobalValidationSummary />

        <!-- Render Current Step Inputs Only -->
        <div class="card mb-4">
            <div class="card-body">
                @foreach (var input in CurrentStepInputs)
                {
                    <DynamicInputField Input="input" InputChanged="OnInputUpdated" />
                }
            </div>
        </div>

        <!-- Wizard Footer Navigation Controls -->
        <div class="d-flex justify-content-between align-items-center">
            <button type="button" 
                    class="btn btn-outline-secondary" 
                    disabled="@(currentStep == 1)" 
                    @onclick="PreviousStep">
                Previous
            </button>

            @if (currentStep < TotalSteps)
            {
                <button type="button" 
                        class="btn btn-primary" 
                        @onclick="NextStepAsync">
                    Next Step
                </button>
            }
            else
            {
                <button type="submit" class="btn btn-success">
                    Submit Form
                </button>
            }
        </div>
    </EditForm>
}

@code {
    [Parameter, EditorRequired]
    public BlockNode Node { get; set; } = default!;

    [Parameter]
    public EventCallback<BlockNode> OnValidSubmit { get; set; }

    private EditContext? editContext;
    private int currentStep = 1;

    private int TotalSteps => Node.Inputs.Any() ? Node.Inputs.Max(x => x.Step) : 1;

    private IEnumerable<BlockNodeInput> CurrentStepInputs => Node.Inputs
        .Where(i => i.Step == currentStep);

    protected override void OnInitialized()
    {
        editContext = new EditContext(Node);
    }

    private async Task NextStepAsync()
    {
        if (editContext == null) return;

        // Validate step fields before allowing navigation forward
        bool isValid = BlockNodeValidator.ValidateStep(Node, currentStep, editContext);

        if (isValid)
        {
            if (currentStep < TotalSteps)
            {
                currentStep++;
                StateHasChanged();
            }
        }
    }

    private void PreviousStep()
    {
        if (currentStep > 1)
        {
            currentStep--;
            StateHasChanged();
        }
    }

    private async Task GoToStepAsync(int targetStep)
    {
        // Users can only jump directly to previously completed steps
        if (targetStep < currentStep)
        {
            currentStep = targetStep;
            StateHasChanged();
        }
    }

    private async Task HandleFinalSubmit()
    {
        // Validate final step before triggering completion callback
        if (editContext != null && BlockNodeValidator.ValidateStep(Node, currentStep, editContext))
        {
            await OnValidSubmit.InvokeAsync(Node);
        }
    }

    private void OnInputUpdated(BlockNodeInput input)
    {
        StateHasChanged();
    }

    private string GetStepTitle(int step) => step switch
    {
        1 => "Basic Information",
        2 => "Advanced Settings & JSON Rules",
        3 => "Confirmation & Review",
        _ => $"Step {step}"
    };
}