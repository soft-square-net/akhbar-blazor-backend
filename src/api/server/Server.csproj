<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>FSH.Starter.WebApi.Host</RootNamespace>
    <AssemblyName>FSH.Starter.WebApi.Host</AssemblyName>
    <RunAOTCompilation>true</RunAOTCompilation>
    <ContainerUser>root</ContainerUser>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\'))</RepoRoot>
  </PropertyGroup>
  <PropertyGroup>
    <ContainerRepository>webapi</ContainerRepository>
    <PublishProfile>DefaultContainer</PublishProfile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\framework\Core\Core.csproj" />
    <ProjectReference Include="..\framework\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\migrations\MSSQL\MSSQL.csproj" />
    <ProjectReference Include="..\migrations\PostgreSQL\PostgreSQL.csproj" />
    <ProjectReference Include="..\modules\Catalog\Catalog.Infrastructure\Catalog.Infrastructure.csproj" />
    <ProjectReference Include="..\modules\Document\Document.Infrastructure\Document.Infrastructure.csproj" />
    <ProjectReference Include="..\modules\Elsa\ElsaWorkflow.Infrastructure\ElsaWorkflow.Infrastructure.csproj" />
    <ProjectReference Include="..\modules\PluginsManager\PluginsManager.Application\PluginsManager.Application.csproj" />
    <ProjectReference Include="..\modules\PluginsManager\PluginsManager.Infrastructure\PluginsManager.Infrastructure.csproj" />
    <ProjectReference Include="..\modules\Todo\Todo.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings - Copy.Development.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="appsettings - Copy.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="appsettings.local.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="appsettings.Development.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Update="assets\defaults\*">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>


  <ItemGroup>
    <!-- Links the source assets folder at the repository root to the build engine -->
    <Content Include="$(RepoRoot)assets\**\*">
      <!-- Keeps the inner folder structure (assets/plugins/...) intact -->
      <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <!-- Copies it to bin/Debug/net9.0/ during standard build -->
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <!-- Copies it to the publish/ folder during dotnet publish -->
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <!-- Ensures everything inside root/assets/plugins is copied automatically -->
    <None Update="assets\plugins\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
