@using BlazorModularEngine.Core.UI.Interfaces


@inject IMenuRegistry MenuRegistry

<MudNavMenu>
  <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>

  <!-- Dynamically Injected Module Menus -->
  <MudText Typo="Typo.caption" Class="px-4 mt-4 mb-2">Modules</MudText>

  @foreach (var item in MenuRegistry.GetItemsForRegion("sidebar"))
  {
    <MudNavLink Href="@item.Href" Icon="@item.Icon">
      @item.Title
    </MudNavLink>
  }
</MudNavMenu>