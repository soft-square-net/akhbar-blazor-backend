<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FSH.Starter.Blazor.Modules.Publish</RootNamespace>
    <AssemblyName>FSH.Starter.Blazor.Modules.Publish</AssemblyName>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSHeroLayout\FSHeroLayout.Blazor\FSHeroLayout.Blazor.csproj" />
    <ProjectReference Include="..\MudBlazorBlocks\MudBlazorBlocks.Blazor\MudBlazorBlocks.Blazor.csproj" />
  </ItemGroup>

  <Target Name="CopyProjectDlls" AfterTargets="Build">
    <!-- Define your destination folder here -->
    <PropertyGroup>
      <DestinationFolder>..\..\..\..\api\server\assets\Plugins</DestinationFolder>
    </PropertyGroup>

    <!-- Copy the main project output and dependencies -->
    <ItemGroup>
      <DllsToCopy Include="$(TargetDir)**\*.dll" />
    </ItemGroup>

    <Copy SourceFiles="@(DllsToCopy)"
          DestinationFolder="$(DestinationFolder)\%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
