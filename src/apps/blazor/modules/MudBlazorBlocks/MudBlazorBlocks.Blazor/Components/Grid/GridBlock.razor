@inject GridEditorState EditorState

<div class="block-wrapper @(EditorState.SelectedItem?.Id == Block.Id ? "selected" : "")"
     style="grid-column: span @Block.ColSpan; grid-row: span @Block.RowSpan;"
     draggable="true"
     @ondragstart="HandleDragStart"
     @ondragover:preventDefault
     @ondrop="HandleDrop"
     @onclick:stopPropagation
     @onclick="() => EditorState.SelectItem(Block)">

  <!-- Action Toolbar overlay on hover/select -->
  <div class="block-toolbar">
    <MudIcon Icon="@Icons.Material.Filled.DragHandle" Class="drag-handle" Size="Size.Small" />
    <span class="block-title">@Block.Type</span>
    @if (Block.Type == BlockType.Container)
    {
      <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" OnClick="AddChild" />
    }
    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="OnDelete" />
  </div>

  <!-- Content Area -->
  <div class="block-body">
    @if (Block.Type == BlockType.Container)
    {
      <div class="nested-grid">
        @foreach (var child in Block.Children)
        {
          <GridBlock Block="child" ParentBlock="Block" />
        }
      </div>
    }
    else if (Block.Type == BlockType.Heading)
    {
      <MudText Typo="Typo.h5">@Block.Content</MudText>
    }
    else if (Block.Type == BlockType.Text)
    {
      <MudText Typo="Typo.body1">@Block.Content</MudText>
    }
    else if (Block.Type == BlockType.Image)
    {
      <img src="@Block.ImageUrl" class="block-img" />
    }
  </div>

  <!-- Mouse Resize Handles -->
  <div class="resize-handle handle-right" @onmousedown="StartResizeWidth" @onmousedown:stopPropagation></div>
  <div class="resize-handle handle-bottom" @onmousedown="StartResizeHeight" @onmousedown:stopPropagation></div>
  <div class="resize-handle handle-corner" @onmousedown="StartResizeBoth" @onmousedown:stopPropagation></div>
</div>

@code {
  [Parameter, EditorRequired] public GridBlockItem Block { get; set; } = null!;
  [Parameter] public GridBlockItem? ParentBlock { get; set; }
  [Parameter] public EventCallback OnRemove { get; set; }

  private void HandleDragStart()
  {
    EditorState.StartDrag(Block);
  }

  private void HandleDrop()
  {
    var dragged = EditorState.DraggedItem;
    if (dragged == null || dragged.Id == Block.Id) return;

    if (ParentBlock != null)
    {
      // Reorder inside the same parent container
      int targetIdx = ParentBlock.Children.IndexOf(Block);
      ParentBlock.Children.Remove(dragged);
      ParentBlock.Children.Insert(Math.Max(0, targetIdx), dragged);
      EditorState.ClearDrag();
      EditorState.NotifyStateChanged();
    }
  }

  private void AddChild()
  {
    Block.Children.Add(new GridBlockItem { Type = BlockType.Text, Content = "New Nested Text Block", ColSpan = 12 });
    EditorState.NotifyStateChanged();
  }

  private void OnDelete()
  {
    ParentBlock?.Children.Remove(Block);
    EditorState.NotifyStateChanged();
  }

  // --- Mouse Resizing Logic ---
  private bool _isResizingWidth;
  private bool _isResizingHeight;
  private double _startX;
  private double _startY;
  private int _startColSpan;
  private int _startRowSpan;

  private void StartResizeWidth(MouseEventArgs e)
  {
    _isResizingWidth = true;
    _startX = e.ClientX;
    _startColSpan = Block.ColSpan;
  }

  private void StartResizeHeight(MouseEventArgs e)
  {
    _isResizingHeight = true;
    _startY = e.ClientY;
    _startRowSpan = Block.RowSpan;
  }

  private void StartResizeBoth(MouseEventArgs e)
  {
    _isResizingWidth = true;
    _isResizingHeight = true;
    _startX = e.ClientX;
    _startY = e.ClientY;
    _startColSpan = Block.ColSpan;
    _startRowSpan = Block.RowSpan;
  }

  // Handled at canvas level via MouseMove / MouseUp
  public void OnMouseMove(MouseEventArgs e, double gridWidthPx, double rowHeightPx = 60)
  {
    if (!_isResizingWidth && !_isResizingHeight) return;

    if (_isResizingWidth)
    {
      double colWidthPx = gridWidthPx / 12.0;
      double deltaX = e.ClientX - _startX;
      int colDiff = (int)Math.Round(deltaX / colWidthPx);
      Block.ColSpan = Math.Clamp(_startColSpan + colDiff, 1, 12);
    }

    if (_isResizingHeight)
    {
      double deltaY = e.ClientY - _startY;
      int rowDiff = (int)Math.Round(deltaY / rowHeightPx);
      Block.RowSpan = Math.Max(1, _startRowSpan + rowDiff);
    }

    EditorState.NotifyStateChanged();
  }

  public void StopResize()
  {
    _isResizingWidth = false;
    _isResizingHeight = false;
  }
}


 <style>
  /* CSS for GridBlock component */
  .block-wrapper {
    position: relative;
    border: 1px dashed #cbd5e1;
    border-radius: 6px;
    padding: 8px;
    background-color: #ffffff;
    min-height: 80px;
    transition: border-color 0.2s, box-shadow 0.2s;
    user-select: none;
  }

    .block-wrapper:hover {
      border-color: #3b82f6;
    }

    .block-wrapper.selected {
      border: 2px solid #2563eb;
      box-shadow: 0 0 0 2px rgba(37, 99, 235, 0.2);
    }

  .block-toolbar {
    display: flex;
    align-items: center;
    gap: 4px;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 2px 6px;
    margin: -8px -8px 8px -8px;
    border-radius: 6px 6px 0 0;
  }

  .drag-handle {
    cursor: grab;
  }

  .block-title {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    color: #64748b;
    flex-grow: 1;
  }

  .nested-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-auto-rows: minmax(60px, auto);
    gap: 12px;
    width: 100%;
    min-height: 100px;
  }

  .block-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
  }

  /* Mouse Resize Handles */
  .resize-handle {
    position: absolute;
    z-index: 10;
  }

  .handle-right {
    top: 0;
    right: 0;
    width: 8px;
    height: 100%;
    cursor: ew-resize;
  }

  .handle-bottom {
    bottom: 0;
    left: 0;
    width: 100%;
    height: 8px;
    cursor: ns-resize;
  }

  .handle-corner {
    bottom: 0;
    right: 0;
    width: 12px;
    height: 12px;
    cursor: nwse-resize;
    background: #2563eb;
    border-radius: 2px 0 4px 0;
  }
      </style>