@using FSH.Starter.Blazor.Modules.MudBlazorBlocks.Blazor.Models
@using FSH.Starter.Blazor.Modules.MudBlazorBlocks.Blazor.Services;
@inject GridDesignerState DesignerState

@implements IDisposable

<MudGrid Class="p-4" Spacing="4">
    <!-- Left Workspace Dashboard Grid Canvas Area -->
    <MudItem XS="12" MD="8">
        <MudPaper Elevation="2" Class="p-4 bg-gray-50 min-h-[600px]">
            <div class="flex justify-between items-center mb-4">
                <MudText Typo="Typo.h5" Color="Color.Primary">Tailwind CSS Grid Canvas</MudText>
                <MudText Typo="Typo.caption" Id="canvas-stats">Blocks Count: @CountAllBlocks(DesignerState.RootContainer)</MudText>
            </div>
            
            <div id="root-grid" style="display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 12px; grid-auto-flow: dense;">
                @foreach (var topLevelChild in DesignerState.RootContainer.Children)
                {
                    <GridBlockNode Block="topLevelChild" />
                }
            </div>
        </MudPaper>
    </MudItem>

    <!-- Right Side MudBlazor Real-Time Property Inspector Panel -->
    <MudItem XS="12" MD="4">
        <MudPaper Elevation="3" Class="p-4 h-full">
            <div class="flex justify-between items-center mb-4 border-b pb-2">
                <MudText Typo="Typo.h6">Property Inspector</MudText>
                @if (DesignerState.SelectedBlock != null)
                {
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Text">@DesignerState.SelectedBlock.Type</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Text">NoneSelected</MudChip>
                }
            </div>

            <div id="inspector-content" class="space-y-4">
                @if (DesignerState.SelectedBlock == null)
                {
                    <div class="text-center py-12 text-gray-400 text-sm">
                        <MudIcon Icon="@Icons.Material.Outlined.TouchApp" Size="Size.Large" Class="mb-2" />
                        <p>Select any block on the canvas to inspect or adjust responsive grid settings.</p>
                    </div>
                }
                else
                {
                    <!-- Column Span Field Control -->
                    <div>
                        <div class="flex justify-between text-xs font-semibold text-gray-700 mb-1">
                            <label>Column Span (1 - 12)</label>
                            <span class="text-primary font-mono font-bold">@DesignerState.SelectedBlock.ColSpan Cols</span>
                        </div>
                        <div class="flex gap-4 items-center">
                            <MudSlider T="int" Min="1" Max="12" Value="DesignerState.SelectedBlock.ColSpan" Size="Size.Medium" Color="Color.Primary" ValueChanged="OnLayoutPropertyChanged" Class="flex-1" />
                            <MudNumericField HideSpinButtons="true" Min="1" Max="12" @bind-Value="DesignerState.SelectedBlock.ColSpan" Variant="Variant.Outlined" Margin="Margin.Dense" Class="w-16" TextChanged="OnLayoutPropertyStringChanged" />
                        </div>
                    </div>

                    <!-- Row Span Field Control -->
                    <div>
                        <div class="flex justify-between text-xs font-semibold text-gray-700 mb-1">
                            <label>Row Span (1 - 10)</label>
                            <span class="text-primary font-mono font-bold">@DesignerState.SelectedBlock.RowSpan Rows</span>
                        </div>
                        <div class="flex gap-4 items-center">
                            <MudSlider T="int" Min="1" Max="10" Value="DesignerState.SelectedBlock.RowSpan" Size="Size.Medium" Color="Color.Primary" ValueChanged="OnLayoutPropertyChanged" Class="flex-1" />
                            <MudNumericField HideSpinButtons="true" Min="1" Max="10" @bind-Value="DesignerState.SelectedBlock.RowSpan" Variant="Variant.Outlined" Margin="Margin.Dense" Class="w-16" TextChanged="OnLayoutPropertyStringChanged" />
                        </div>
                    </div>

                    <!-- Heading Specific Element Configurations -->
                    @if (DesignerState.SelectedBlock.Type == "Heading")
                    {
                        <MudSelect T="string" Label="Heading Element Tag" Value="DesignerState.SelectedBlock.TagName" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" ValueChanged="(_) => DesignerState.NotifyStateChanged()">
                            <MudSelectItem Value="@("h1")">H1 Main Page Title</MudSelectItem>
                            <MudSelectItem Value="@("h2")">H2 Section Header</MudSelectItem>
                            <MudSelectItem Value="@("h3")">H3 Component Header</MudSelectItem>
                        </MudSelect>
                    }

                    <!-- Content Editor Input -->
                    @if (DesignerState.SelectedBlock.Type != "Container" && DesignerState.SelectedBlock.Type != "Image")
                    {
                        <MudTextField T="string" Label="Block Text/HTML Content" Lines="3" Variant="Variant.Outlined" @Value="DesignerState.SelectedBlock.Content" ValueChanged="(_) => DesignerState.NotifyStateChanged()" For="@(() => DesignerState.SelectedBlock.Content)" />
                    }
                }
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    protected override void OnInitialized()
    {
        DesignerState.OnStateChanged += StateHasChanged;
        if (!DesignerState.RootContainer.Children.Any())
        {
            DesignerState.InitDemoData();
        }
    }

    private void OnLayoutPropertyChanged(int val)
    {
        DesignerState.RecalculateAllContainerRowSpans();
        DesignerState.NotifyStateChanged();
    }

    private void OnLayoutPropertyStringChanged(string s)
    {
        DesignerState.RecalculateAllContainerRowSpans();
        DesignerState.NotifyStateChanged();
    }

    private int CountAllBlocks(GridBlockItem container)
    {
        int count = container.Children.Count;
        foreach (var c in container.Children)
        {
            if (c.Type == "Container") count += CountAllBlocks(c);
        }
        return count;
    }

    public void Dispose()
    {
        DesignerState.OnStateChanged -= StateHasChanged;
    }
}
