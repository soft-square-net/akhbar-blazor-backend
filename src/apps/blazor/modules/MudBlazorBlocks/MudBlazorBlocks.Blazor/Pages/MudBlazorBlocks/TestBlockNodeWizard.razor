@page "/block-wizard"

@* TestBlockNodeVizard.razor *@
@using FSH.Starter.Blazor.Modules.MudBlazorBlocks.Blazor.Abstraction.BlockNode
@using FSH.Starter.Blazor.Modules.MudBlazorBlocks.Blazor.Components.Blocks.EditForm

<div class="container my-4">
    <h2>Dynamic Form with State Reset</h2>
    <BlockNodeWizard OnValidSubmit="HandleValidSubmit" Node="currentNode" />
</div>

@code {
    private BlockNode currentNode = new();
    protected override void OnAfterRender(bool firstRender)
    {
        
        base.OnAfterRender(firstRender);

        if (firstRender)
        {
            var jsonNode = BlockNode.FromJson(JsonPayload);
            // Keep a pristine master copy
     
            currentNode =   jsonNode.DeepClone();
            StateHasChanged();
        }
    }
    
    
    private void HandleValidSubmit()
    {
        Console.WriteLine("Submitted successfully!");
        StateHasChanged();
        // Update the baseline snapshot to the current state after a successful save
       
    }


    
     private string JsonPayload = @"
                                {
  ""Id"": ""node_wizard_1"",
  ""Name"": ""Multi-Step Webhook Setup"",
  ""Inputs"": [
    {
      ""Id"": ""webhook_name"",
      ""Label"": ""Webhook Name"",
      ""Type"": ""text"",
      ""Step"": 1,
      ""Validation"": { ""IsRequired"": true }
    },
    {
      ""Id"": ""target_url"",
      ""Label"": ""Target Endpoint URL"",
      ""Type"": ""text"",
      ""Step"": 1,
      ""Validation"": { ""IsRequired"": true }
    },
    {
      ""Id"": ""headers_json"",
      ""Label"": ""Headers (JSON)"",
      ""Type"": ""json"",
      ""Step"": 2,
      ""Validation"": { ""IsRequired"": true }
    },
    {
      ""Id"": ""retry_count"",
      ""Label"": ""Max Retries"",
      ""Type"": ""number"",
      ""Value"": 3,
      ""Step"": 3
    }
  ]
}
                                 ";
}

