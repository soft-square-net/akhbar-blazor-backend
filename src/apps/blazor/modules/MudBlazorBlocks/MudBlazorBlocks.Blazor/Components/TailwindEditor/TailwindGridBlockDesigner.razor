<div class="h-screen flex flex-col overflow-hidden bg-mud-background">

    <!-- Top MudBlazor App Bar -->
    <header class="bg-mud-appbar text-white px-6 py-3 shadow-md flex items-center justify-between z-30 shrink-0">
        <div class="flex items-center space-x-3">
            <div class="bg-white/20 p-2 rounded-lg text-white">
                <i class="fa-solid fa-cubes text-xl"></i>
            </div>
            <div>
                <h1 class="font-bold text-lg leading-none">Blazor WASM Grid Block Designer</h1>
                <p class="text-xs text-white/80 mt-0.5">Absolute Overlay Toolbars & Auto-Scaling Container Heights</p>
            </div>
        </div>
        
        <!-- Action Controls -->
        <div class="flex items-center space-x-2">
            <div class="hidden md:flex items-center space-x-1.5 bg-white/10 p-1 rounded-lg mr-2">
                <button class="btn-top-add px-2.5 py-1 text-xs font-medium bg-white/20 hover:bg-white/30 rounded transition text-white" data-type="Container">
                    <i class="fa-solid fa-plus text-[10px] mr-1"></i> Container
                </button>
                <button class="btn-top-add px-2.5 py-1 text-xs font-medium bg-white/20 hover:bg-white/30 rounded transition text-white" data-type="Heading">
                    <i class="fa-solid fa-plus text-[10px] mr-1"></i> Heading
                </button>
                <button class="btn-top-add px-2.5 py-1 text-xs font-medium bg-white/20 hover:bg-white/30 rounded transition text-white" data-type="Paragraph">
                    <i class="fa-solid fa-plus text-[10px] mr-1"></i> Text
                </button>
                <button class="btn-top-add px-2.5 py-1 text-xs font-medium bg-white/20 hover:bg-white/30 rounded transition text-white" data-type="Image">
                    <i class="fa-solid fa-plus text-[10px] mr-1"></i> Image
                </button>
            </div>

            <button id="btn-clear" class="px-3 py-1.5 text-xs font-medium bg-white/10 hover:bg-white/20 rounded-md transition flex items-center gap-1.5">
                <i class="fa-solid fa-rotate-left"></i> Reset
            </button>
            <button id="btn-export" class="px-4 py-1.5 text-xs font-semibold bg-mud-secondary hover:bg-pink-600 text-white rounded-md shadow transition flex items-center gap-2">
                <i class="fa-solid fa-code"></i> Export HTML
            </button>
        </div>
    </header>

    <!-- Main Workspace -->
    <div class="flex flex-1 overflow-hidden">
        
        <!-- Left Tool Palette Sidebar -->
        <aside class="w-64 bg-white border-r border-mud-border flex flex-col shrink-0 shadow-sm z-20">
            <div class="p-4 border-b border-mud-border">
                <h2 class="text-xs font-bold text-gray-500 uppercase tracking-wider">Block Library</h2>
                <p class="text-xs text-gray-400 mt-1">Drag items or click '+' to append</p>
            </div>

            <div class="p-4 space-y-3 overflow-y-auto flex-1">
                <!-- Container -->
                <div class="palette-item cursor-grab active:cursor-grabbing p-3 bg-indigo-50/60 border border-indigo-100 hover:border-mud-primary rounded-lg flex items-center gap-3 transition group"
                     draggable="true" data-type="Container">
                    <div class="w-8 h-8 rounded bg-mud-primary text-white flex items-center justify-center text-sm shadow-sm group-hover:scale-105 transition">
                        <i class="fa-solid fa-border-all"></i>
                    </div>
                    <div>
                        <div class="text-sm font-semibold text-gray-800">Container</div>
                        <div class="text-[11px] text-gray-500">Auto-Scaling Grid</div>
                    </div>
                </div>

                <!-- Heading -->
                <div class="palette-item cursor-grab active:cursor-grabbing p-3 bg-white border border-gray-200 hover:border-mud-primary rounded-lg flex items-center gap-3 transition group shadow-sm"
                     draggable="true" data-type="Heading">
                    <div class="w-8 h-8 rounded bg-blue-500 text-white flex items-center justify-center text-sm shadow-sm group-hover:scale-105 transition">
                        <i class="fa-solid fa-heading"></i>
                    </div>
                    <div>
                        <div class="text-sm font-semibold text-gray-800">Heading</div>
                        <div class="text-[11px] text-gray-500">Titles (H1, H2, H3)</div>
                    </div>
                </div>

                <!-- Paragraph -->
                <div class="palette-item cursor-grab active:cursor-grabbing p-3 bg-white border border-gray-200 hover:border-mud-primary rounded-lg flex items-center gap-3 transition group shadow-sm"
                     draggable="true" data-type="Paragraph">
                    <div class="w-8 h-8 rounded bg-emerald-500 text-white flex items-center justify-center text-sm shadow-sm group-hover:scale-105 transition">
                        <i class="fa-solid fa-paragraph"></i>
                    </div>
                    <div>
                        <div class="text-sm font-semibold text-gray-800">Paragraph</div>
                        <div class="text-[11px] text-gray-500">Text block</div>
                    </div>
                </div>

                <!-- Image -->
                <div class="palette-item cursor-grab active:cursor-grabbing p-3 bg-white border border-gray-200 hover:border-mud-primary rounded-lg flex items-center gap-3 transition group shadow-sm"
                     draggable="true" data-type="Image">
                    <div class="w-8 h-8 rounded bg-amber-500 text-white flex items-center justify-center text-sm shadow-sm group-hover:scale-105 transition">
                        <i class="fa-solid fa-image"></i>
                    </div>
                    <div>
                        <div class="text-sm font-semibold text-gray-800">Image</div>
                        <div class="text-[11px] text-gray-500">Media block</div>
                    </div>
                </div>

                <!-- Custom HTML -->
                <div class="palette-item cursor-grab active:cursor-grabbing p-3 bg-white border border-gray-200 hover:border-mud-primary rounded-lg flex items-center gap-3 transition group shadow-sm"
                     draggable="true" data-type="CustomHtml">
                    <div class="w-8 h-8 rounded bg-purple-500 text-white flex items-center justify-center text-sm shadow-sm group-hover:scale-105 transition">
                        <i class="fa-solid fa-code"></i>
                    </div>
                    <div>
                        <div class="text-sm font-semibold text-gray-800">Custom HTML</div>
                        <div class="text-[11px] text-gray-500">Raw HTML / Controls</div>
                    </div>
                </div>
            </div>

            <!-- Quick Add Helpers -->
            <div class="p-4 border-t border-mud-border bg-gray-50/50">
                <span class="text-xs font-semibold text-gray-500">Quick Append:</span>
                <div class="grid grid-cols-2 gap-2 mt-2">
                    <button class="btn-quick-add text-xs py-1.5 px-2 bg-white border border-gray-300 hover:bg-gray-100 rounded text-gray-700 font-medium" data-type="Heading">+ Title</button>
                    <button class="btn-quick-add text-xs py-1.5 px-2 bg-white border border-gray-300 hover:bg-gray-100 rounded text-gray-700 font-medium" data-type="Paragraph">+ Text</button>
                    <button class="btn-quick-add text-xs py-1.5 px-2 bg-white border border-gray-300 hover:bg-gray-100 rounded text-gray-700 font-medium" data-type="Image">+ Image</button>
                    <button class="btn-quick-add text-xs py-1.5 px-2 bg-mud-primary text-white hover:bg-mud-primary-hover rounded font-medium" data-type="Container">+ Grid</button>
                </div>
            </div>
        </aside>

        <!-- Center Canvas Area -->
        <main class="flex-1 overflow-auto p-6 bg-mud-background flex flex-col items-center">
            <div id="designer-canvas" class="w-full max-w-6xl bg-white rounded-xl shadow-md border border-mud-border p-6 min-h-[650px] flex flex-col transition-all">
                <div class="flex items-center justify-between pb-4 mb-4 border-b border-gray-100">
                    <div class="flex items-center space-x-2">
                        <span class="w-3 h-3 rounded-full bg-red-400 inline-block"></span>
                        <span class="w-3 h-3 rounded-full bg-amber-400 inline-block"></span>
                        <span class="w-3 h-3 rounded-full bg-green-400 inline-block"></span>
                        <span class="text-xs font-medium text-gray-400 ml-2">Root Canvas (Floating Toolbars & Dynamic Auto RowSpans)</span>
                    </div>
                    <div id="canvas-stats" class="text-xs text-gray-400 font-mono">Blocks: 0</div>
                </div>

                <!-- Root Grid Region -->
                <div id="root-grid" class="grid-container-12 flex-1 relative bg-slate-50/50 p-3 rounded-lg border border-dashed border-gray-200">
                    <!-- Blocks dynamically rendered -->
                </div>
            </div>
        </main>

        <!-- Right MudBlazor Property Inspector Sidebar -->
        <aside class="w-80 bg-white border-l border-mud-border flex flex-col shrink-0 shadow-sm z-20">
            <div class="p-4 border-b border-mud-border flex items-center justify-between bg-gray-50/50">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-sliders text-mud-primary"></i>
                    <h2 class="text-sm font-bold text-gray-800">Property Inspector</h2>
                </div>
                <span id="selected-type-badge" class="text-[10px] font-bold px-2 py-0.5 rounded bg-gray-200 text-gray-600 uppercase">None</span>
            </div>

            <!-- Inspector Form Content -->
            <div id="inspector-content" class="p-5 space-y-5 overflow-y-auto flex-1">
                <div class="text-center py-12 text-gray-400 text-sm">
                    <i class="fa-regular fa-hand-pointer text-3xl mb-2 block text-gray-300"></i>
                    Select any block on the canvas to inspect and edit spans, content, or styling.
                </div>
            </div>
        </aside>
    </div>

    <!-- Export Code Modal -->
    <div id="export-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center hidden opacity-0 transition-opacity duration-200">
        <div class="bg-white rounded-xl shadow-2xl w-full max-w-3xl overflow-hidden flex flex-col max-h-[85vh]">
            <div class="px-6 py-4 bg-mud-dark text-white flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-code text-mud-secondary"></i>
                    <h3 class="font-bold text-base">Generated Responsive CSS Grid HTML</h3>
                </div>
                <button id="btn-close-modal" class="text-gray-400 hover:text-white transition">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="p-6 overflow-y-auto flex-1 bg-gray-900 text-gray-100 font-mono text-xs">
                <pre><code id="export-code-block" class="whitespace-pre-wrap break-all"></code></pre>
            </div>
            <div class="px-6 py-3 bg-gray-100 border-t border-gray-200 flex justify-between items-center">
                <span class="text-xs text-gray-500">Pure inline-styled CSS Grid code ready for web output.</span>
                <button id="btn-copy-code" class="px-4 py-2 bg-mud-primary hover:bg-mud-primary-hover text-white font-medium rounded-md text-xs transition flex items-center gap-2">
                    <i class="fa-regular fa-copy"></i> Copy HTML
                </button>
            </div>
        </div>
    </div>
</div>
