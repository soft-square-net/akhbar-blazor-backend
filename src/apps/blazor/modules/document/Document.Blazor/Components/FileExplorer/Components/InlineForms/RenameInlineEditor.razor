@using System.Text.RegularExpressions
@using FSH.Starter.Blazor.Modules.Document.Blazor.Components.FileExplorer.Models

@inject IJSRuntime JSRuntime


  @if (!_isEditing)
{
  <div tabindex="0" @onclick="() => MudTextClick()" @onclick:preventDefault >
    <MudText Typo="Typo.caption" Style="max-width:80px;margin-inline:auto;text-wrap-style: balance; overflow-wrap: break-word; ">@Model.Name</MudText>
  </div>
}
else
{
  <MudTextField tabindex="0" @ref="multilineReference"
                T="string"
                id="fileExplorerRenameInput"
                Typo="Typo.caption"
                Style="text-align:center;"
                Lines="1"
                Sizing="InputSizing.Auto"
                MaxLines="6"
                Text="@Model.Name"
                ValueChanged="newValue => NameValueChanged(newValue)"
                Variant="Variant.Outlined"
                Margin="Margin.Dense"
                Class="center-text-field"
                @onfocus="HandleFocus"
                OnKeyDown="(e) => HandelOnInputKeyDown(e)"
                @onfocusout="(e) => HandelOnInputFocusOut(e)" 
                Immediate="true"
                Validation="@(new Func<string, string>(ValidateFileName))" />
}
@code {
  [Parameter, EditorRequired] public BaseExplorerItemModel Model { get; set; }
  private MudTextField<string> multilineReference;

  private bool _isEditing = false;
  private bool _needsFocus = false;
  private string _oldName = string.Empty;


  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (_needsFocus && multilineReference != null)
    {
      _needsFocus = false; // Reset flag immediately to prevent infinite loops

      await Task.Delay(50); // Small delay to let MudBlazor finish internal component setup
      await multilineReference.FocusAsync();
      await multilineReference.SelectAsync();
    }

  }

  #region MudText Read
  protected void MudTextClick()
  {
    if (Model.IsSelected) { 
      _isEditing = true; 
      _oldName = Model.Name; 
      _needsFocus = true;
    }
  }
  #endregion

  #region MudTextField Edit Actions
  private async Task HandleFocus()
  {
    // Small delay ensures MudBlazor finishes rendering the focus state
    // 1. Allow the default browser focus cycle to finish rendering
    await Task.Delay(50);
    // await JSRuntime.InvokeVoidAsync("helpers.selectFileNameWithoutExtension", "fileExplorerRenameInput");
    // 2. Find the extension boundary
    int dotIndex = Model.Name.LastIndexOf('.');
    int selectionEnd = dotIndex != -1 ? dotIndex : Model.Name.Length;
    // 3. Highlight from index 0 to the calculated boundary natively via MudBlazor
    if (multilineReference != null)
    {
      await multilineReference.FocusAsync();
      await multilineReference.SelectRangeAsync(0, selectionEnd);
    }
  }

  private void NameValueChanged(string newValue)
  {
    Model.Name = newValue;
    if (multilineReference is not null) multilineReference!.Value = newValue;
  }

  private async Task HandelOnInputKeyDown(KeyboardEventArgs e)
  {
    await Task.Delay(50);
    // Check if the pressed key is Enter or NumpadEnter
    if (e.Key == "Enter" || e.Key == "NumpadEnter")
    {
      // if (_isEditing) multilineReference.SelectRangeAsync(0, Model.Name.Length - 4);
      // Built-in MudBlazor method to remove focus from the input field
      if (multilineReference != null)
      {
        Model.Name = multilineReference!.Value;
        // Drop focus immediately on enter
        await multilineReference.BlurAsync();
        _isEditing = false;
      }
    }
    else if (e.Key == "Escape")
    {
      Model.Name = _oldName;
      _isEditing = false;
    }
  }
  private async Task HandelOnInputFocusOut(FocusEventArgs e)
  {
    await Task.Delay(50);
    // if (multilineReference != null)
    // {
    Model.Name = multilineReference!.Value ?? _oldName;
    // // Drop focus immediately on enter
    await multilineReference.BlurAsync();
    _isEditing = false;
    // }
  }

  private string ValidateFileName(string value)
  {
    if (string.IsNullOrWhiteSpace(value))
    {
      return Loc.GetString("File name cannot be empty.");
    }

    // Regex pattern for illegal characters: \ / : * ? " < > |
    // Note: We escape characters like \ and [ ] inside the regex pattern
    var illegalCharactersRegex = new Regex(@"[\\/:*?""<>|]");

    if (illegalCharactersRegex.IsMatch(value))
    {
      return Loc.GetString("Name cannot contain: \\ / : * ? \" < > |");
    }

    return null; // Returning null means the input is completely valid
  }
  #endregion
  
}

<style>
  /* Center the text inside the input/textarea */
  .center-text-field textarea,
  .center-text-field input {
    text-align: center !important;
    @* padding: 0.2rem !important; *@
  }

  /* Optional: Emulate the Windows Explorer compact border/padding look */
  .explorer-rename-container {
    max-width: 250px;
    margin: 20px auto;
  }

  .center-text-field .mud-input-outlined-border {
    border-color: #0078d7 !important; /* Windows blue highlight color */
    border-width: 1px !important;
  }

</style>