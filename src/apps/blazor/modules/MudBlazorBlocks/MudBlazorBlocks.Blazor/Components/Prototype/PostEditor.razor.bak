@* PostEditor.razor *@
@using System.Text.Json
@using FSH.Starter.Blazor.Modules.MudBlazorBlocks.Blazor.Components.Models

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h4">Cross-Parent Drag & Drop Block Editor</MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddRootBlock">Add Root Block</MudButton>
    </MudStack>

    @* SINGLE CONTAINER MANAGING ALL BLOCKS IN THE SYSTEM *@
    <MudDropContainer T="PostBlock"
                      Items="AllBlocks"
                      ItemsSelector="@((item, dropzone) => (item.ParentId ?? "root") == dropzone)"
                      ItemDropped="OnItemDropped"
                      Class="d-flex flex-column flex-grow-1">
        <ChildContent>
            <MudDropZone T="PostBlock" Identifier="root" Class="pa-2 rounded flex-grow-1 min-h-100">
                @foreach (var block in GetRootBlocks())
                {
                    <PostBlockNode Block="block"
                                   AllBlocks="AllBlocks"
                                   OnDelete="RemoveBlock"
                                   OnAddChild="AddChildBlock" />
                }
            </MudDropZone>
        </ChildContent>
        <ItemRenderer>
            @* Visual feedback while dragging *@
            <MudPaper Class="pa-2 my-1 color-surface" Elevation="4">
                <MudText Typo="Typo.body2">Moving: <strong>@context.Title</strong></MudText>
            </MudPaper>
        </ItemRenderer>
    </MudDropContainer>
</MudContainer>

@code {
    private List<PostBlock> AllBlocks { get; set; } = new();

    protected override void OnInitialized()
    {
        var root1 = new PostBlock { Title = "Root Section 1", Content = "Parent A", Order = 0, IsEditing = false };
        var child1 = new PostBlock { ParentId = root1.Id, Title = "Nested Child 1.1", Content = "Inside Parent A", Order = 0, IsEditing = false };
        
        var root2 = new PostBlock { Title = "Root Section 2", Content = "Parent B", Order = 1, IsEditing = false };

        AllBlocks.AddRange(new[] { root1, child1, root2 });
    }

    private IEnumerable<PostBlock> GetRootBlocks() => AllBlocks.Where(b => b.ParentId == null).OrderBy(b => b.Order);

    private void AddRootBlock()
    {
        AllBlocks.Add(new PostBlock { Title = "New Root Block", Order = AllBlocks.Count(b => b.ParentId == null) });
    }

    private void AddChildBlock(string parentId)
    {
        AllBlocks.Add(new PostBlock 
        { 
            ParentId = parentId, 
            Title = "New Sub-Block", 
            Order = AllBlocks.Count(b => b.ParentId == parentId) 
        });
    }

    private void RemoveBlock(PostBlock block)
    {
        // Recursively delete children
        var idsToRemove = GetSubtreeIds(block.Id);
        AllBlocks.RemoveAll(b => idsToRemove.Contains(b.Id));
    }

    private HashSet<string> GetSubtreeIds(string rootId)
    {
        var ids = new HashSet<string> { rootId };
        var children = AllBlocks.Where(b => b.ParentId == rootId).ToList();
        foreach (var child in children)
        {
            ids.UnionWith(GetSubtreeIds(child.Id));
        }
        return ids;
    }

    private void OnItemDropped(MudItemDropInfo<PostBlock> dropInfo)
    {
        if (dropInfo.Item == null) return;

        // Prevent dragging a parent block into one of its own descendants
        if (dropInfo.DropzoneIdentifier != "root" && IsDescendant(dropInfo.Item.Id, dropInfo.DropzoneIdentifier))
        {
            return;
        }

        // 1. Update the parent reference based on the dropzone identifier
        dropInfo.Item.ParentId = dropInfo.DropzoneIdentifier == "root" ? null : dropInfo.DropzoneIdentifier;

        // 2. Re-index items in the target zone to maintain order
        var siblingZoneItems = AllBlocks
            .Where(b => (b.ParentId ?? "root") == dropInfo.DropzoneIdentifier)
            .OrderBy(b => b.Order)
            .ToList();

        siblingZoneItems.Remove(dropInfo.Item);
        int targetIndex = Math.Min(dropInfo.IndexInZone, siblingZoneItems.Count);
        siblingZoneItems.Insert(targetIndex, dropInfo.Item);

        for (int i = 0; i < siblingZoneItems.Count; i++)
        {
            siblingZoneItems[i].Order = i;
        }
    }

    private bool IsDescendant(string currentId, string targetParentId)
    {
        var targetNode = AllBlocks.FirstOrDefault(b => b.Id == targetParentId);
        while (targetNode != null)
        {
            if (targetNode.Id == currentId) return true;
            targetNode = AllBlocks.FirstOrDefault(b => b.Id == targetNode.ParentId);
        }
        return false;
    }
}