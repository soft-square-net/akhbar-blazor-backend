
@using Microsoft.AspNetCore.Components.Authorization
@using Blazorizer.Pages.Auth
@using BlazorModularEngine.Core.UI.Interfaces
@inject ILayoutManager LayoutManager
@implements IDisposable

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(DynamicHostLayout)">
                <Authorizing>
                    <p>Checking authentication status...</p>
                </Authorizing>
                <NotAuthorized>
                    @if (@context.User.Identity?.IsAuthenticated is true)
                    {
                        <p>You are not authorized to be here.</p>
                    }
                    else
                    {
                        <Login />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(DynamicHostLayout)">
                <p role="alert">Sorry, there's nothing at this address.</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code
{
    protected override void OnInitialized()
    {
        LayoutManager.OnLayoutChanged += StateHasChanged;
    }

    public void Dispose()
    {
        LayoutManager.OnLayoutChanged -= StateHasChanged;
    }
}
