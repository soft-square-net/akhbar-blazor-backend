@using FSH.Starter.BlazorShared.Services
@* Blazor.Shared/Components/General/ContextMenu.razor *@
@inject ContextMenuService MenuService
@implements IDisposable

@if (isVisible)
{
  <div class="context-menu" style="position: fixed; left: @(x)px; top: @(y)px; z-index: 1000;">
    @ChildContent(selectedItem)
  </div>
}

@code {
  [Parameter] public RenderFragment<object?> ChildContent { get; set; } = default!;

  private bool isVisible;
  private double x;
  private double y;
  private object? selectedItem;

  protected override void OnInitialized()
  {
    MenuService.OnShow += ShowMenu;
    MenuService.OnHide += HideMenu;
  }

  private void ShowMenu(double mouseX, double mouseY, object item)
  {
    x = mouseX;
    y = mouseY;
    selectedItem = item;
    isVisible = true;
    StateHasChanged();
  }

  private void HideMenu()
  {
    if (isVisible)
    {
      isVisible = false;
      StateHasChanged();
    }
  }

  public void Dispose()
  {
    MenuService.OnShow -= ShowMenu;
    MenuService.OnHide -= HideMenu;
  }
}
