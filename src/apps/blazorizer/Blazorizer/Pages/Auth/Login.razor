@page "/login"
@attribute [AllowAnonymous]
@* @inject IAuthenticationService authService *@

@namespace Blazorizer.Pages.Auth
 
<div class="login-page">
  <EditForm Model="@_tokenRequest" OnValidSubmit="SubmitAsync" class="login">
        <DataAnnotationsValidator />

    <span class="logo">your logo here</span>

    <label for="email">email!!</label>
    <input type="email" name="email" @bind-value="_tokenRequest.Email" required id="email" placeholder="email">

    <label for="password">password</label>
    <input type="password" name="password" @bind-value="_tokenRequest.Password" id="password" required placeholder="password">
 
    <label for="tent">senha</label>
    <input type="text" name="TenantId" @bind-value="TenantId"  required placeholder="Tenant">

    <button type="submit">login</button>

    <div class="termos">
      <input type="checkbox" id="termos" name="termos" required>
      <label for="termos">
        Aceito os <a href="#">termos de uso</a>
      </label>
    </div>

  </EditForm>
</div>


