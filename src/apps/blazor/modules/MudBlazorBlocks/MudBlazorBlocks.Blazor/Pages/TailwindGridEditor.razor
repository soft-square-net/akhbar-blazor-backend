@code {
  private IJSObjectReference? _module;

  override protected async Task OnAfterRenderAsync(bool firstRender)
  {
    await base.OnAfterRenderAsync(firstRender);
    if (firstRender)
    {
      // Inject Tailwind CDN and Config dynamically

      await JS.InjectScriptPromiseAsync("https://cdn.tailwindcss.com", head: true, async: false);

      // 2. Set up your runtime adjustments if you have a custom configuration script


      await JS.InvokeVoidAsync("eval", confTailwind);


      // 3. Force Tailwind to process Blazor's active elements
      await RefreshTailwindDOMAsync();


      await JS.InjectStyleSheetAsync("https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css");

      await JS.InjectStyleSheetAsync("https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap");

      // await LoadInternalScript("wwwroot/js/tailwindGridBlockDesigner.js");
      // _module = await JS.LoadAssemblyScript(GetType().Assembly, "wwwroot/js/tailwindGridBlockDesigner.js");
      _module = await JS.LoadAssemblyScript(GetType().Assembly, "wwwroot/js/module2.js");

      // await _module.InvokeVoidAsync("initializeTailwindGridBlockDesigner", DotNetObjectReference.Create(this));
      await _module.InvokeVoidAsync("initDesigner");

      StateHasChanged();
    }
  }

  public  async ValueTask RefreshTailwindDOMAsync()
  {
    // Forces Tailwind's MutationObserver to trigger a manual scan over Blazor's components
    await JS.InvokeVoidAsync("eval", "if (window.tailwind) { window.tailwind.config = window.tailwind.config || {}; }");
  }

  public void Dispose()
  {
    _module?.DisposeAsync();
    _module = null;
  }

