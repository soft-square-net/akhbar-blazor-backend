@using FSH.Starter.Blazor.Modules.Document.Blazor.Components.FileExplorer.Components;
@using FSH.Starter.Blazor.Modules.Document.Blazor.Components.FileExplorer.Components.FileBrowser.Views.Default
@using FSH.Starter.Blazor.Modules.Document.Blazor.Components.FileExplorer.Components.FileBrowser.Views.Tabular
@using FSH.Starter.Blazor.Modules.Document.Blazor.Components.FileExplorer.Models
@using FSH.Starter.BlazorShared.Components.General
@using FSH.Starter.BlazorShared.Services

@inject ContextMenuService MenuService
@switch (ExplorerType)
{
  case EnumExplorerType.DefaultExplorer:
    <FileBrowserDefaultFileView />
    break;
  case EnumExplorerType.TabularExplorer:
    <FileBrowserTabularFileView />
    break;
  default:
    break;
}

@* Single instance definition with strongly-typed template content *@
<ContextMenu>
    @context {
        @if (context is BaseExplorerItemModel item)
        {
            <button @onclick="() => EditItem(item)">Edit @item.Name</button>
            <button @onclick="() => DeleteItem(item)">Delete</button>
        }
    }
</ContextMenu>
<div>
  Current Folder Items: @CurrentFolder.Files.Count
</div>
@code{
    [CascadingParameter(Name = "CurrentFolder")] FolderModel CurrentFolder { get; set; }
  private void HideGlobalMenu() => MenuService.Hide();
  private void EditItem(BaseExplorerItemModel item) { /* Your Logic */ }
  private void DeleteItem(BaseExplorerItemModel item) { /* Your Logic */ }

    [Parameter, EditorRequired]
    public EnumExplorerType ExplorerType { get; set; } = EnumExplorerType.DefaultExplorer;


    RenderFragment Render()
    {
      return new RenderFragment(builder =>
      {
        builder.AddContent(0, "my fragment");
      });
    }
  }